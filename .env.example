# Copy to .env (never commit .env). Loaded by pydantic-settings in src/scrapekit/config.py.
ANTHROPIC_API_KEY=
# Hard spending cap for LLM extraction, in USD (Day 5)
SCRAPEKIT_LLM_BUDGET_USD=1.00
# LLM extraction model — cost/quality is a config decision, not a code change (Day 5)
SCRAPEKIT_LLM_MODEL=claude-opus-4-8
# Optional proxy, e.g. http://user:pass@host:port
SCRAPEKIT_PROXY_URL=
